{#-
{% import 'macros/octicons.twig' as octicons %}
{{ octicons.svg('<icon>', <16|24>, '<class>') }}
-#}
{%- macro svg(name, size = 24, class = '') -%}
  {%- set icon = site.data.octicons[name].heights[size] ?? null -%}
  {%- if icon is null -%}
    {#- not found: "?" -#}
    {%- set size = 16 -%}
    {%- set icon = site.data.octicons['question'].heights[size] -%}
  {%- endif -%}
  <svg{% if class %} class="{{ class }}"{% endif %} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{ icon.width }} {{ size }}" fill="currentColor" aria-hidden="true">{{ icon.path }}</svg>
{%- endmacro -%}